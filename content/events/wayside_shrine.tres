[resource]
script = ExtResource("3_a40ap")
id = &"wayside_shrine"
title = "The Wayside Shrine"
text = "A shrine of cracked stone leans against a dead oak. Someone keeps its candles burning, though no one has walked this road in years. Coins glint in the offering bowl."
choices = Array[ExtResource("1_26ibk")]([SubResource("Resource_3xfm3"), SubResource("Resource_k4kxa"), SubResource("Resource_c35jc")])
