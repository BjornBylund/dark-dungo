[sub_resource type="Resource" id="Resource_ji3gi"]
script = ExtResource("2_kkx2m")
kind = 3
amount = 2.0
heirloom = &"crest"

[sub_resource type="Resource" id="Resource_ukucm"]
script = ExtResource("1_ww0en")
label = "Tend him"
requires = ExtResource("3_x4mst")
success = Array[ExtResource("2_kkx2m")]([SubResource("Resource_b3mx6"), SubResource("Resource_ji3gi")])
success_text = "The bleeding slows. He presses a signet into the Vestal's palm before the fever takes his words."

[sub_resource type="Resource" id="Resource_w103l"]
script = ExtResource("2_kkx2m")
