amount = 2.0

[sub_resource type="Resource" id="Resource_6gjnf"]
script = ExtResource("1_ww0en")
label = "Take his purse"
success = Array[ExtResource("2_kkx2m")]([SubResource("Resource_w103l"), SubResource("Resource_g7003")])
success_text = "He does not resist. He only watches."

[sub_resource type="Resource" id="Resource_nh0cw"]
script = ExtResource("1_ww0en")
label = "Walk on"
success_text = "His breathing follows you a long way down the road."

[resource]
script = ExtResource("4_l5cdd")
id = &"wounded_stranger"
title = "A Wounded Stranger"
text = "A man lies in the ditch, clutching a wound that will not close. His purse is heavy and his breathing is not."
choices = Array[ExtResource("1_ww0en")]([SubResource("Resource_ukucm"), SubResource("Resource_6gjnf"), SubResource("Resource_nh0cw")])
