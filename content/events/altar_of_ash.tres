token = &"strength"

[sub_resource type="Resource" id="Resource_3ke0j"]
script = ExtResource("1_mbl0s")
label = "Offer blood"
success = Array[ExtResource("2_jwa6t")]([SubResource("Resource_tittd"), SubResource("Resource_31lbh")])
success_text = "The ash drinks. Your arms feel lighter."

[sub_resource type="Resource" id="Resource_rrcul"]
script = ExtResource("2_jwa6t")
