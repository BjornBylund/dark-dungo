success_text = "The Minstrel's voice fills the nave, and the ash settles."

[resource]
script = ExtResource("4_wykuh")
id = &"altar_of_ash"
title = "The Altar of Ash"
text = "Ash drifts from an altar that has not held a fire in a hundred years. Dark stains run down its sides, and the air hums with a promise of strength."
choices = Array[ExtResource("1_mbl0s")]([SubResource("Resource_3ke0j"), SubResource("Resource_yrsri"), SubResource("Resource_g7e1q")])
