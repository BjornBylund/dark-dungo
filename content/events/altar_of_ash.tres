amount = 1.0

[sub_resource type="Resource" id="Resource_yrsri"]
script = ExtResource("1_mbl0s")
label = "Take the candlesticks"
success = Array[ExtResource("2_jwa6t")]([SubResource("Resource_rrcul"), SubResource("Resource_jjv2g")])
success_text = "Silver, heavy, and warm to the touch."

[sub_resource type="Resource" id="Resource_3yrp5"]
script = ExtResource("2_jwa6t")
